{
    "name": "petermarkley/tollerus",
    "description": "A conlang dictionary Laravel package - build, browse, and publish your conlang's lexical data online",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Peter Markley",
            "email": "peter@petermarkley.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "PeterMarkley\\Tollerus\\": "src/"
        }
    },
    "require": {
        "illuminate/support": "^12.0",
        "livewire/livewire": "^3.6",
        "masterminds/html5": "^2.10"
    },
    "extra": {
        "laravel": {
            "providers": [
                "PeterMarkley\\Tollerus\\Providers\\TollerusServiceProvider"
            ]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "orchestra/pest-plugin-testbench": "^4.1"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
